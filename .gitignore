# ============================================================
#  OPPO A5 一键 Root 工具箱 —— Git 忽略规则
#  目的：仓库里只留「代码 + 小工具」，
#        永不入库 4 GB 级镜像和每次运行产生的临时数据。
# ============================================================

# ---- 现场制作出来的系统镜像（3.75 GB 级）：仓库和发布包都不放 ----
bin/images/*.img
bin/images/*.raw
bin/images/*.sparse

# ---- 运行时目录：工具箱每次运行都会写入 ----
bin/backup/
bin/logs/
bin/work/
bin/_stage/

# ---- 打包产物 ----
build/

# ---- 日志与临时文件 ----
*.log
*.tmp
*.bak